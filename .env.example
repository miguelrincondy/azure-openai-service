# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=<nombre-del-deployment>
AZURE_OPENAI_API_VERSION=2024-10-21

# api_key | managed_identity
AUTH_MODE=api_key
AZURE_OPENAI_API_KEY=

# --- App ---
SERVICE_NAME=azure-openai-service
SERVICE_VERSION=0.1.0
DEPLOY_ENVIRONMENT=dev
APP_PORT=8000

# --- OneAgent (opcional, solo si reportas a un ambiente distinto al que
# horneaste en la imagen; ver README "Reportar a otro ambiente Dynatrace") ---
# DT_TENANT=
# DT_TENANTTOKEN=
# DT_CONNECTION_POINT=
