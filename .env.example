# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=<nombre-del-deployment>
AZURE_OPENAI_API_VERSION=2024-10-21

# api_key | managed_identity
AUTH_MODE=api_key
AZURE_OPENAI_API_KEY=

# --- Observabilidad (OpenLLMetry / Traceloop) ---
# Formato: https://<tu-environment-id>.<tu-dominio>/api/v2/otlp
DT_OTLP_ENDPOINT=https://<tu-environment-id>.sprint.dynatracelabs.com/api/v2/otlp
# Access Token con scopes: openTelemetryTrace.ingest, metrics.ingest, logs.ingest
DT_API_TOKEN=
# Dynatrace solo acepta métricas en formato delta
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=DELTA

# --- App ---
SERVICE_NAME=azure-openai-service
SERVICE_VERSION=0.1.0
DEPLOY_ENVIRONMENT=dev
APP_PORT=8000